---
import Layout from '../components/Layout.astro';
import zh from '../i18n/zh.json';
---

<Layout
  lang="zh"
  title="关于 · RedSamerai"
  description="RedSamerai 是谁、在做什么，以及这个站点的来源。"
  pagePath="about"
>
  <section class="py-24 min-h-[80vh] flex items-center">
    <div class="max-w-5xl mx-auto px-6 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">
        <div class="fade-in order-2 md:order-1">
          <div class="glass-card photo-placeholder aspect-[3/4]">
            <span class="block text-center px-4 relative z-10">
              <div class="text-5xl mb-3 opacity-30">👤</div>
              个人照片<br/>800×1067
            </span>
          </div>
        </div>
        <div class="fade-in fade-in-delay-1 order-1 md:order-2">
          <p class="font-mono text-[#E4B863] text-sm mb-6 tracking-wide">// about</p>
          <h1 class="font-serif text-5xl md:text-6xl font-semibold tracking-tight leading-tight text-white">{zh.about.title}</h1>
          <p class="mt-8 text-lg text-white/80 leading-relaxed max-w-[65ch]">{zh.about.bio}</p>
          <div class="mt-12">
            <h2 class="font-mono text-sm text-white/40 mb-4 uppercase tracking-widest">{zh.about.skillsTitle}</h2>
            <div class="flex flex-wrap gap-2">
              {zh.about.skills.map((skill) => (
                <span class="text-sm font-mono border border-white/15 hover:border-[#E4B863]/40 rounded-2xl px-3 py-1.5 text-white/60 hover:text-[#F3DCA8] transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] cursor-default">{skill}</span>
              ))}
            </div>
          </div>
          <div class="mt-12 flex gap-4">
            <a
              href="https://github.com/RedSamerai"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-gold inline-flex items-center px-5 py-3 text-sm font-medium rounded-2xl"
            >
              GitHub ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
