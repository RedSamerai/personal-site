---
import Layout from '../components/Layout.astro';
import zh from '../i18n/zh.json';
---

<Layout lang="zh">
  <section class="py-24">
    <div class="max-w-2xl mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight">{zh.about.title}</h1>
      <p class="mt-8 text-lg leading-relaxed text-fg/80">{zh.about.bio}</p>

      <h2 class="mt-12 text-sm font-mono text-muted">// {zh.about.skillsTitle}</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {zh.about.skills.map((skill) => (
          <span
            class="text-sm font-mono border border-fg/20 rounded px-3 py-1 hover:border-accent/60 hover:text-accent transition-colors cursor-default"
          >
            {skill}
          </span>
        ))}
      </div>
    </div>
  </section>
</Layout>
