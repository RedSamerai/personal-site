---
import Layout from '../components/Layout.astro';
import zh from '../i18n/zh.json';

const works = [
  {
    title: 'Alpha Signal',
    desc: '多因子量化策略回测框架，支持向量化回测与归因分析。',
    tags: ['量化', 'Python', '开源'],
    href: 'https://github.com/RedSamerai/alpha-signal',
    external: true,
  },
  {
    title: 'SceneAI',
    desc: '基于 LLM 的剧本分镜分析工具，自动拆解镜头语言与节奏曲线。',
    tags: ['影视分析', 'AI'],
    href: 'https://github.com/RedSamerai/sceneai',
    external: true,
  },
  {
    title: 'TabLens',
    desc: 'Chrome 扩展：对信息流做智能摘要与降噪筛选，提升阅读效率。',
    tags: ['Chrome扩展', 'TypeScript'],
    href: 'https://github.com/RedSamerai/tablens',
    external: true,
  },
  {
    title: '《暗线》',
    desc: '原创悬疑剧本，双时间线叙事，正在打磨第二稿。',
    tags: ['剧本创作'],
    href: null,
    external: false,
  },
  {
    title: 'astro-i18n-kit',
    desc: '极简的 Astro 多语言脚手架，零依赖实现中英双语路由。',
    tags: ['开源项目', 'Astro'],
    href: 'https://github.com/RedSamerai/astro-i18n-kit',
    external: true,
  },
];
---

<Layout lang="zh">
  <section class="py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight">{zh.works.title}</h1>
      <p class="mt-4 text-muted">{zh.works.subtitle}</p>

      <!-- 分类标签（占位：后续做点击筛选） -->
      <div class="mt-10 flex flex-wrap gap-2">
        {zh.works.categories.map((cat) => (
          <span class="text-sm font-mono text-muted border border-fg/15 rounded px-2.5 py-0.5 hover:border-accent/50 transition-colors">
            {cat}
          </span>
        ))}
      </div>

      <!-- 项目卡片列表 -->
      <div class="mt-12 space-y-4">
        {works.map((w) => (
          <a
            href={w.href ?? '#'}
            {w.href && w.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            class="block border border-fg/10 rounded-lg p-6 hover:border-accent/50 hover:translate-x-1 transition-all"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-xl font-bold hover:text-accent transition-colors">
                  {w.title}
                  {w.external && <span class="ml-2 text-xs font-mono text-muted">↗</span>}
                </h2>
                <p class="mt-2 text-sm text-muted leading-relaxed">{w.desc}</p>
                <div class="mt-4 flex gap-2 flex-wrap">
                  {w.tags.map((tag) => (
                    <span class="text-xs font-mono text-accent/80 border border-accent/30 rounded px-1.5 py-0.5">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
