---
import Layout from '../components/Layout.astro';
import zh from '../i18n/zh.json';

const works = [
  { title: 'AI简历生成器', desc: '输入基本信息，自动生成排版精美的简历PDF。支持多模板切换。', tags: ['AI', '产品'], href: '#' },
  { title: 'Excel表格比对工具', desc: '一键对比两份Excel，高亮差异单元格，输出比对报告。', tags: ['Excel工具', 'Python'], href: '#' },
  { title: 'QuantTrade', desc: '量化回测框架，支持向量化策略测试与归因分析。', tags: ['量化', 'Python', '开源'], href: 'https://github.com/RedSamerai' },
  { title: '交易数据清洗', desc: 'MT5导出数据自动清洗，去除无效K线，统一格式，生成分析就绪的CSV。', tags: ['数据清洗', '量化'], href: 'https://github.com/RedSamerai/quantclean' },
  { title: '会议纪要工具包V2', desc: '实时语音转写 + 本地LLM摘要，自动生成结构化会议纪要。', tags: ['AI', '产品', 'Python'], href: '#' },
  { title: 'Chrome视频翻译扩展', desc: '本地Whisper转写 + 自动字幕，无需联网翻译。', tags: ['Chrome扩展', 'AI', '开源'], href: 'https://github.com/RedSamerai/video-summary-extension' },
  { title: 'A股量化MCP', desc: 'AKShare封装的MCP服务器，选股/北向资金/龙虎榜/两融等11个工具。', tags: ['量化', 'MCP', '开源'], href: 'https://github.com/RedSamerai/a-stock-mcp' },
  { title: '《二人组》剧本', desc: '十集犯罪剧，对标《绝命毒师》《风骚律师》风格。正在创作中。', tags: ['剧本创作'], href: '#' },
];
---

<Layout lang="zh">
  <section class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="fade-in">
        <h1 class="font-serif text-5xl md:text-6xl font-semibold tracking-tight">{zh.works.title}</h1>
        <p class="mt-6 text-xl text-fg-muted font-light leading-relaxed max-w-xl">{zh.works.subtitle}</p>
      </div>
      <div class="mt-16 space-y-0">
        {works.map((w, i) => (
          <a
            href={w.href ?? '#'}
            {w.href && w.href !== '#' ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            class="group flex flex-col md:flex-row gap-6 py-10 border-b border-fg/7 hover:bg-surface/20 -mx-4 px-4 rounded transition-colors fade-in"
            style={`transition-delay: ${i * 0.05}s`}
          >
            <div class="w-full md:w-64 shrink-0 aspect-[4/3] bg-surface rounded-lg flex items-center justify-center overflow-hidden">
              <span class="text-4xl opacity-15">📷</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-4">
                <h2 class="font-serif text-2xl font-semibold group-hover:text-accent-hover transition-colors">{w.title}</h2>
                {w.href && w.href !== '#' && (
                  <span class="text-fg-subtle font-mono text-sm shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">↗</span>
                )}
              </div>
              <p class="mt-3 text-fg-muted leading-relaxed max-w-lg">{w.desc}</p>
              <div class="mt-5 flex gap-2 flex-wrap">
                {w.tags.map((tag) => (
                  <span class="text-xs font-mono text-fg-subtle border border-fg/10 rounded px-2.5 py-1">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
