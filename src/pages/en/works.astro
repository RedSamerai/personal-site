---
import Layout from '../../components/Layout.astro';
import en from '../../i18n/en.json';

const works = [
  {
    title: 'AI Resume Generator',
    desc: 'Auto-generates polished resume PDFs from basic info. Multiple templates supported.',
    tags: ['AI', 'Product'],
    href: '#',
  },
  {
    title: 'Excel Compare Tool',
    desc: 'One-click Excel comparison with highlighted differences and report output.',
    tags: ['Excel', 'Python'],
    href: '#',
  },
  {
    title: 'QuantTrade',
    desc: 'Quant backtesting framework with vectorized strategy testing and attribution analysis.',
    tags: ['Quant', 'Python', 'OpenSource'],
    href: 'https://github.com/RedSamerai',
  },
  {
    title: 'Trade Data Cleaner',
    desc: 'Auto-clean MT5 export data, remove invalid candles, normalize formats.',
    tags: ['Data Cleaning', 'Quant'],
    href: 'https://github.com/RedSamerai/quantclean',
  },
  {
    title: 'Meeting Minutes Tool V2',
    desc: 'Real-time speech-to-text + local LLM summarization for structured meeting notes.',
    tags: ['AI', 'Product', 'Python'],
    href: '#',
  },
  {
    title: 'Chrome Video Translator',
    desc: 'Local Whisper transcription + auto subtitles, no internet needed.',
    tags: ['ChromeExt', 'AI', 'OpenSource'],
    href: 'https://github.com/RedSamerai/video-summary-extension',
  },
  {
    title: 'A-Share Quant MCP',
    desc: 'AKShare-based MCP server: stock screening, northbound flow, Dragon Tiger, margin data.',
    tags: ['Quant', 'MCP', 'OpenSource'],
    href: 'https://github.com/RedSamerai/a-stock-mcp',
  },
  {
    title: '《Two As One》Screenplay',
    desc: '10-episode crime drama, inspired by Breaking Bad and Better Call Saul.',
    tags: ['Screenplay'],
    href: '#',
  },
];
---

<Layout lang="en">
  <section class="py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight">{en.works.title}</h1>
      <p class="mt-4 text-muted">{en.works.subtitle}</p>

      <div class="mt-10 flex flex-wrap gap-2">
        {en.works.categories.map((cat) => (
          <span class="text-sm font-mono text-muted border border-fg/15 rounded px-2.5 py-0.5 hover:border-accent/50 transition-colors">
            {cat}
          </span>
        ))}
      </div>

      <div class="mt-12 space-y-4">
        {works.map((w) => (
          <a
            href={w.href ?? '#'}
            {w.href && w.href !== '#' ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            class="block border border-fg/10 rounded-lg p-6 hover:border-accent/50 hover:translate-x-1 transition-all"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-xl font-bold hover:text-accent transition-colors">
                  {w.title}
                  {w.href && w.href !== '#' && <span class="ml-2 text-xs font-mono text-muted">↗</span>}
                </h2>
                <p class="mt-2 text-sm text-muted leading-relaxed">{w.desc}</p>
                <div class="mt-4 flex gap-2 flex-wrap">
                  {w.tags.map((tag) => (
                    <span class="text-xs font-mono text-accent/80 border border-accent/30 rounded px-1.5 py-0.5">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
