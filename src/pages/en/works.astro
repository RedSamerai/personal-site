---
import Layout from '../../components/Layout.astro';
import en from '../../i18n/en.json';

const works = [
  { title: 'AI Resume Generator', desc: 'Auto-generates polished resume PDFs from basic info. Multiple templates supported.', tags: ['AI', 'Product'], href: '#' },
  { title: 'Excel Compare Tool', desc: 'One-click Excel comparison with highlighted differences and report output.', tags: ['Excel', 'Python'], href: '#' },
  { title: 'QuantTrade', desc: 'Quant backtesting framework with vectorized strategy testing and attribution analysis.', tags: ['Quant', 'Python', 'OpenSource'], href: 'https://github.com/RedSamerai' },
  { title: 'Trade Data Cleaner', desc: 'Auto-clean MT5 export data, remove invalid candles, normalize formats.', tags: ['Data Cleaning', 'Quant'], href: 'https://github.com/RedSamerai/quantclean' },
  { title: 'Meeting Minutes Tool V2', desc: 'Real-time speech-to-text + local LLM summarization for structured meeting notes.', tags: ['AI', 'Product', 'Python'], href: '#' },
  { title: 'Chrome Video Translator', desc: 'Local Whisper transcription + auto subtitles, no internet needed.', tags: ['ChromeExt', 'AI', 'OpenSource'], href: 'https://github.com/RedSamerai/video-summary-extension' },
  { title: 'A-Share Quant MCP', desc: 'AKShare-based MCP server: stock screening, northbound flow, Dragon Tiger, margin data.', tags: ['Quant', 'MCP', 'OpenSource'], href: 'https://github.com/RedSamerai/a-stock-mcp' },
  { title: '《Two As One》Screenplay', desc: '10-episode crime drama, inspired by Breaking Bad and Better Call Saul.', tags: ['Screenplay'], href: '#' },
];
---

<Layout lang="en">
  <section class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="fade-in">
        <h1 class="font-serif text-5xl md:text-6xl font-semibold tracking-tight">{en.works.title}</h1>
        <p class="mt-6 text-xl text-fg-muted font-light leading-relaxed max-w-xl">{en.works.subtitle}</p>
      </div>
      <div class="mt-16 space-y-0">
        {works.map((w, i) => (
          <a
            href={w.href ?? '#'}
            {w.href && w.href !== '#' ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            class="group flex flex-col md:flex-row gap-6 py-10 border-b border-fg/7 hover:bg-surface/20 -mx-4 px-4 rounded transition-colors fade-in"
            style={`transition-delay: ${i * 0.05}s`}
          >
            <div class="w-full md:w-64 shrink-0 aspect-[4/3] bg-surface rounded-lg flex items-center justify-center overflow-hidden">
              <span class="text-4xl opacity-15">📷</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-4">
                <h2 class="font-serif text-2xl font-semibold group-hover:text-accent-hover transition-colors">{w.title}</h2>
                {w.href && w.href !== '#' && (
                  <span class="text-fg-subtle font-mono text-sm shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">↗</span>
                )}
              </div>
              <p class="mt-3 text-fg-muted leading-relaxed max-w-lg">{w.desc}</p>
              <div class="mt-5 flex gap-2 flex-wrap">
                {w.tags.map((tag) => (
                  <span class="text-xs font-mono text-fg-subtle border border-fg/10 rounded px-2.5 py-1">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
