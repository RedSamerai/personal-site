---
import Layout from '../../components/Layout.astro';
import en from '../../i18n/en.json';

const works = [
  {
    title: 'Alpha Signal',
    desc: 'Vectorized backtesting framework for multi-factor strategies, with attribution analysis.',
    tags: ['Quant', 'Python', 'OpenSource'],
    href: 'https://github.com/RedSamerai/alpha-signal',
    external: true,
  },
  {
    title: 'SceneAI',
    desc: 'LLM-based screenplay storyboard analyzer — auto-decomposes shot language and pacing curves.',
    tags: ['Film', 'AI'],
    href: 'https://github.com/RedSamerai/sceneai',
    external: true,
  },
  {
    title: 'TabLens',
    desc: 'Chrome extension that smart-summarizes and denoises your feeds for faster reading.',
    tags: ['ChromeExt', 'TypeScript'],
    href: 'https://github.com/RedSamerai/tablens',
    external: true,
  },
  {
    title: '《Dark Thread》(暗线)',
    desc: 'Original mystery screenplay, dual-timeline narrative — second draft in progress.',
    tags: ['Screenplay'],
    href: null,
    external: false,
  },
  {
    title: 'astro-i18n-kit',
    desc: 'Zero-dependency bilingual routing scaffold for Astro.',
    tags: ['OpenSource', 'Astro'],
    href: 'https://github.com/RedSamerai/astro-i18n-kit',
    external: true,
  },
];
---

<Layout lang="en">
  <section class="py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight">{en.works.title}</h1>
      <p class="mt-4 text-muted">{en.works.subtitle}</p>

      <div class="mt-10 flex flex-wrap gap-2">
        {en.works.categories.map((cat) => (
          <span class="text-sm font-mono text-muted border border-fg/15 rounded px-2.5 py-0.5 hover:border-accent/50 transition-colors">
            {cat}
          </span>
        ))}
      </div>

      <div class="mt-12 space-y-4">
        {works.map((w) => (
          <a
            href={w.href ?? '#'}
            {w.href && w.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            class="block border border-fg/10 rounded-lg p-6 hover:border-accent/50 hover:translate-x-1 transition-all"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-xl font-bold hover:text-accent transition-colors">
                  {w.title}
                  {w.external && <span class="ml-2 text-xs font-mono text-muted">↗</span>}
                </h2>
                <p class="mt-2 text-sm text-muted leading-relaxed">{w.desc}</p>
                <div class="mt-4 flex gap-2 flex-wrap">
                  {w.tags.map((tag) => (
                    <span class="text-xs font-mono text-accent/80 border border-accent/30 rounded px-1.5 py-0.5">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
