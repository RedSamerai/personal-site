---
import Layout from '../../components/Layout.astro';
import NavAccordion from '../../components/nav/NavAccordion.astro';
import Changelog from '../../components/nav/Changelog.astro';
---

<Layout
  lang="en"
  title="RedSamerai · Curated Resource Nav"
  description="A curated navigation of hard-to-find, actually-useful sites: video &amp; magnet, open source, AI, PC/mobile, learning &amp; certs. Updated regularly."
  pagePath=""
>
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Changelog above the main nav area -->
      <Changelog />

      <!-- Accordion: categories on the left, content on the right -->
      <NavAccordion lang="en" />
    </div>
  </section>
</Layout>
