---
import Layout from '../../components/Layout.astro';
import en from '../../i18n/en.json';

const works = [
  { title: 'AI Resume Generator', desc: 'Auto-generates polished resume PDFs from basic info. Multiple templates supported.', tags: ['AI', 'Product'] },
  { title: 'Excel Compare Tool', desc: 'One-click Excel comparison with highlighted differences and report output.', tags: ['Excel', 'Python'] },
  { title: 'QuantTrade', desc: 'Quant backtesting framework with vectorized strategy testing and attribution analysis.', tags: ['Quant', 'Python', 'OpenSource'] },
  { title: 'Trade Data Cleaner', desc: 'Auto-clean MT5 export data, remove invalid candles, normalize formats.', tags: ['Data Cleaning', 'Quant'] },
  { title: 'Meeting Minutes Tool V2', desc: 'Real-time speech-to-text + local LLM summarization for structured meeting notes.', tags: ['AI', 'Product', 'Python'] },
  { title: 'Chrome Video Translator', desc: 'Local Whisper transcription + auto subtitles, no internet needed.', tags: ['ChromeExt', 'AI', 'OpenSource'] },
  { title: 'A-Share Quant MCP', desc: 'AKShare-based MCP server: stock screening, northbound flow, Dragon Tiger, margin data.', tags: ['Quant', 'MCP', 'OpenSource'] },
  { title: '《Two As One》Screenplay', desc: '10-episode crime drama, inspired by Breaking Bad and Better Call Saul.', tags: ['Screenplay'] },
];

const featured = works.slice(0, 3);
---

<Layout lang="en">
  <!-- Hero -->
  <section class="py-24 md:py-32">
    <div class="max-w-4xl mx-auto px-6">
      <p class="font-mono text-accent text-sm mb-4">// hello, world</p>
      <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-none">
        {en.name}
      </h1>
      <p class="mt-6 text-2xl md:text-3xl font-light text-muted">{en.tagline}</p>
      <p class="mt-4 text-fg/70 max-w-lg">{en.heroDescription}</p>
    </div>
  </section>

  <!-- Featured works -->
  <section class="pb-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-sm font-mono text-muted mb-8">// recent works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {featured.map((w) => (
          <a href="/en/works" class="group border border-fg/10 rounded-lg p-5 hover:border-accent/50 transition-colors">
            <h3 class="font-bold text-lg group-hover:text-accent transition-colors">{w.title}</h3>
            <p class="text-sm text-muted mt-2 line-clamp-2">{w.desc}</p>
            <div class="mt-4 flex gap-2 flex-wrap">
              {w.tags.map((tag) => (
                <span class="text-xs font-mono text-accent/80 border border-accent/30 rounded px-1.5 py-0.5">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <a href="/en/works" class="text-sm font-mono text-muted hover:text-accent transition-colors">
          → view all works
        </a>
      </div>
    </div>
  </section>
</Layout>
