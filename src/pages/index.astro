---
import Layout from '../components/Layout.astro';
import NavAccordion from '../components/nav/NavAccordion.astro';
import Changelog from '../components/nav/Changelog.astro';
---

<Layout
  lang="zh"
  title="RedSamerai · 精选资源导航"
  description="普通人搜不到、真正有用的站点精选：影视磁力、开源、AI、电脑手机、学习考证。持续更新。"
  pagePath=""
>
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-6">
      <!-- 更新日志（导航主区域上方） -->
      <Changelog />

      <!-- 手风琴：左分类 + 右内容 -->
      <NavAccordion lang="zh" />
    </div>
  </section>
</Layout>
