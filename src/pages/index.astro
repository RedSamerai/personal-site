---
import Layout from '../components/Layout.astro';
import zh from '../i18n/zh.json';

const works = [
  { title: 'AI简历生成器', desc: '输入基本信息，自动生成排版精美的简历PDF。支持多模板切换。', tags: ['AI', '产品'] },
  { title: 'Excel表格比对工具', desc: '一键对比两份Excel，高亮差异单元格，输出比对报告。', tags: ['Excel工具', 'Python'] },
  { title: 'QuantTrade', desc: '量化回测框架，支持向量化策略测试与归因分析。', tags: ['量化', 'Python', '开源'] },
  { title: '交易数据清洗', desc: 'MT5导出数据自动清洗，去除无效K线，统一格式。', tags: ['数据清洗', '量化'] },
  { title: '会议纪要工具包V2', desc: '实时语音转写 + 本地LLM摘要，自动生成结构化会议纪要。', tags: ['AI', '产品', 'Python'] },
  { title: 'Chrome视频翻译扩展', desc: '本地Whisper转写 + 自动字幕，无需联网翻译。', tags: ['Chrome扩展', 'AI', '开源'] },
  { title: 'A股量化MCP', desc: 'AKShare封装的MCP服务器，选股/北向/龙虎榜等11个工具。', tags: ['量化', 'MCP', '开源'] },
  { title: '《二人组》剧本', desc: '十集犯罪剧，对标《绝命毒师》《风骚律师》风格。', tags: ['剧本创作'] },
];

// 首页只展示前 3 个作品的缩略卡片
const featured = works.slice(0, 3);
---

<Layout lang="zh">
  <!-- Hero -->
  <section class="py-24 md:py-32">
    <div class="max-w-4xl mx-auto px-6">
      <p class="font-mono text-accent text-sm mb-4">// hello, world</p>
      <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-none">
        {zh.name}
      </h1>
      <p class="mt-6 text-2xl md:text-3xl font-light text-muted">
        {zh.tagline}
      </p>
      <p class="mt-4 text-fg/70 max-w-lg">{zh.heroDescription}</p>
    </div>
  </section>

  <!-- 作品预览网格 -->
  <section class="pb-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-sm font-mono text-muted mb-8">// 近期作品</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {featured.map((w) => (
          <a
            href="/works"
            class="group border border-fg/10 rounded-lg p-5 hover:border-accent/50 transition-colors"
          >
            <h3 class="font-bold text-lg group-hover:text-accent transition-colors">
              {w.title}
            </h3>
            <p class="text-sm text-muted mt-2 line-clamp-2">{w.desc}</p>
            <div class="mt-4 flex gap-2 flex-wrap">
              {w.tags.map((tag) => (
                <span class="text-xs font-mono text-accent/80 border border-accent/30 rounded px-1.5 py-0.5">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <a href="/works" class="text-sm font-mono text-muted hover:text-accent transition-colors">
          → 查看全部作品
        </a>
      </div>
    </div>
  </section>
</Layout>
