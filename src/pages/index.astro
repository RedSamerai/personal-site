---
import Layout from '../components/Layout.astro';
import zh from '../i18n/zh.json';
import { getCollection } from 'astro:content';

const works = [
  { title: 'Alpha Signal', desc: '多因子量化策略回测框架', tags: ['量化', 'Python'] },
  { title: 'SceneAI', desc: '基于 LLM 的剧本分镜分析与生成工具', tags: ['影视分析', 'AI'] },
  { title: 'TabLens', desc: 'Chrome 扩展：信息流智能摘要与筛选', tags: ['Chrome扩展'] },
  { title: '《暗线》', desc: '原创悬疑剧本（进行中）', tags: ['剧本创作'] },
  { title: 'astro-i18n-kit', desc: '极简 Astro 多语言脚手架', tags: ['开源项目'] },
];

// 首页只展示前 3 个作品的缩略卡片
const featured = works.slice(0, 3);
---

<Layout lang="zh">
  <!-- Hero -->
  <section class="py-24 md:py-32">
    <div class="max-w-4xl mx-auto px-6">
      <p class="font-mono text-accent text-sm mb-4">// hello, world</p>
      <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-none">
        {zh.name}
      </h1>
      <p class="mt-6 text-2xl md:text-3xl font-light text-muted">
        {zh.tagline}
      </p>
      <p class="mt-4 text-fg/70 max-w-lg">{zh.heroDescription}</p>
    </div>
  </section>

  <!-- 作品预览网格 -->
  <section class="pb-24">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-sm font-mono text-muted mb-8">// 近期作品</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {featured.map((w) => (
          <a
            href="/works"
            class="group border border-fg/10 rounded-lg p-5 hover:border-accent/50 transition-colors"
          >
            <h3 class="font-bold text-lg group-hover:text-accent transition-colors">
              {w.title}
            </h3>
            <p class="text-sm text-muted mt-2 line-clamp-2">{w.desc}</p>
            <div class="mt-4 flex gap-2 flex-wrap">
              {w.tags.map((tag) => (
                <span class="text-xs font-mono text-accent/80 border border-accent/30 rounded px-1.5 py-0.5">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <a href="/works" class="text-sm font-mono text-muted hover:text-accent transition-colors">
          → 查看全部作品
        </a>
      </div>
    </div>
  </section>
</Layout>
