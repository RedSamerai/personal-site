---
const { lang = 'zh' } = Astro.props;
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

const nav = {
  zh: { about: '关于' },
  en: { about: 'About' },
};
const t = nav[lang];
const prefix = lang === 'en' ? '/en' : '';
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-fg/7">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={prefix + '/'} class="font-serif text-xl font-semibold tracking-tight hover:text-fg-muted transition-colors">
      RS
    </a>
    <ul class="flex items-center gap-6">
      <li>
        <a href={prefix + '/about'} class="text-sm font-medium text-fg-muted hover:text-fg transition-colors">
          {t.about}
        </a>
      </li>
      <li>
        <LanguageSwitch lang={lang} />
      </li>
      <li>
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>
