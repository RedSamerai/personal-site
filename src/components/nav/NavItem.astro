---
// 单个导航条目渲染组件（Nocturne 玻璃卡片）
// props: item, subcategoryId, lang（zh/en）
const { item, subcategoryId, lang = 'zh' } = Astro.props;

// 失效反馈：跳转 GitHub Issue
const issueUrl =
  `https://github.com/RedSamerai/personal-site/issues/new?title=` +
  encodeURIComponent(`[失效] ${subcategoryId} ${item.name}`) +
  `&body=` +
  encodeURIComponent(`链接已失效`);

// 新增加入：added 距今 < 14 天显示香槟金圆点
const addedDate = item.added ? new Date(item.added + 'T00:00:00') : null;
const isNew = addedDate
  ? (Date.now() - addedDate.getTime()) / 86400000 < 14
  : false;

const t = {
  zh: { vpn: '🔓 需科学上网', report: '失效反馈' },
  en: { vpn: '🔓 VPN required', report: 'Report broken' },
}[lang];

// EN 页显示英文说明 note_en，否则显示中文 note
const noteText = lang === 'en' ? (item.note_en || item.note) : item.note;
---

<li class="glass-card group/item flex items-start gap-3 p-5 md:p-6">
  <div class="flex-1 min-w-0 relative z-10">
    <div class="flex items-center gap-2 flex-wrap">
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-white hover:text-[#F3DCA8] transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] break-all focus:outline-none focus:shadow-[0_0_0_3px_rgba(228,184,99,0.18)] rounded-2xl"
      >
        {item.name}
      </a>
      {item.stars && (
        <span class="text-xs font-mono text-[#E4B863]">⭐ {item.stars}</span>
      )}
      {item.vpn && (
        <span class="text-xs font-mono text-white/60 bg-white/8 border border-white/15 rounded-2xl px-2 py-0.5">
          {t.vpn}
        </span>
      )}
      {isNew && (
        <span
          class="relative flex w-2 h-2"
          title="新增加入（14天内）"
        >
          <span class="absolute inline-flex w-full h-full rounded-full bg-[#E4B863] opacity-60"></span>
          <span class="relative inline-flex w-2 h-2 rounded-full bg-[#E4B863]"></span>
        </span>
      )}
    </div>
    {noteText && (
      <p class="mt-1.5 text-sm text-white/60 leading-relaxed max-w-[65ch]">{noteText}</p>
    )}
  </div>
  <a
    href={issueUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t.report}
    title={t.report}
    class="relative z-10 shrink-0 text-white/40 hover:text-[#E4B863] transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] text-sm opacity-0 group-hover/item:opacity-100 focus:opacity-100 focus:outline-none focus:shadow-[0_0_0_3px_rgba(228,184,99,0.18)] rounded-2xl"
  >
    ⚠
  </a>
</li>
