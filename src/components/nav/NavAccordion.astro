---
// 两层手风琴组件：一级大项分类 + 二级小项展开
// 交互：
//   一级：点分类 → 右侧显示该分类的小项按钮列表（二级），其他一级关闭
//   二级：点小项 → 立即展开该小项的 NavItem 列表，小项之间互斥
//   点已展开的小项 → 收起回小项列表；点已展开的一级 → 回到默认（profile）
//   移动端：一级纵向堆叠在上方，二级在下方；切二级后自动滚到内容区顶
// 性能：右侧内容区只渲染当前激活的分类/小项（DOM 节点 = 活跃分支，不随总条目数膨胀）
import NavItem from './NavItem.astro';
import PersonalPanel from './PersonalPanel.astro';

// 自动纳入 src/data/nav/ 下所有分类 JSON（01..09 + 未来新增的 10-ai 等），
// 不再硬编码 import；加新分类只丢 json 文件即可
const modules = import.meta.glob('../../data/nav/0*.json', { eager: true });
const categories = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

const lang = Astro.props.lang ?? 'zh';
const titleOf = (c) => (lang === 'en' && c.title_en ? c.title_en : c.title);
const subTitleOf = (s) => (lang === 'en' && s.title_en ? s.title_en : s.title);
---

<div class="nav-acc grid grid-cols-1 md:grid-cols-[240px_1fr] gap-6 md:gap-8 items-start">
  <!-- 左侧：一级大项按钮（桌面固定 240px 宽；移动端纵向堆叠在上方） -->
  <div class="nav-sidebar shrink-0" aria-label="分类">
    <div class="flex flex-col gap-2 md:sticky md:top-24">
      {categories.map((c) => (
        <button
          type="button"
          data-l1={c.id}
          aria-expanded="false"
          class="l1-btn text-left px-4 py-3 rounded-2xl border border-white/15 hover:border-white/30 bg-white/6 backdrop-blur-[30px] md:backdrop-blur-[40px] backdrop-saturate-[180%] transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] flex items-center justify-between gap-2 focus:outline-none focus:shadow-[0_0_0_3px_rgba(228,184,99,0.18)]"
        >
          <span class="font-mono text-sm font-medium text-white/80">
            <span class="text-white/40 mr-2">{c.id}</span>
            <span class="l1-title">{titleOf(c)}</span>
          </span>
          <span class="l1-arrow text-white/40 text-sm" aria-hidden="true">→</span>
        </button>
      ))}
    </div>
  </div>

  <!-- 右侧：内容区（只渲染激活分支） -->
  <div class="nav-content min-w-0" id="nav-content">
    <!-- 默认：个人信息面板（未选一级时） -->
    <div data-panel="profile">
      <PersonalPanel lang={lang} />
    </div>

    <!-- 激活分类容器：由 JS 动态填充，初始为空 -->
    <div data-panel="cat" class="acc-cat hidden"></div>
  </div>
</div>

<!-- 把分类数据注入为可被 <script> 访问的全局变量（SSR 注入，无网络请求） -->
<script is:inline define:vars={{ navCategories: categories }}>
  window.__NAV_CATEGORIES__ = navCategories;
</script>

<script>
  // 分类数据（由上方 <script is:inline> 注入到 window；SSR 时已含全部数据）
  const CATS = window.__NAV_CATEGORIES__;
  // 语言 + 标题选择（与组件 frontmatter 保持一致）
  const lang = document.documentElement.lang?.startsWith('zh') ? 'zh' : 'en';
  const titleOf = (c) => (lang === 'en' && c.title_en ? c.title_en : c.title);
  const subTitleOf = (s) => (lang === 'en' && s.title_en ? s.title_en : s.title);
  const content = document.querySelector('#nav-content');
  const profilePanel = content.querySelector('[data-panel="profile"]');
  const catSlot = content.querySelector('[data-panel="cat"]');
  const l1Btns = [...document.querySelectorAll('.l1-btn')];
  let openCat = null;
  let openSub = null;

  const isMobile = () => window.innerWidth < 768;

  function esc(s) {
    return String(s).replace(/[&<>"']/g, (ch) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);
  }

  // 渲染指定分类的小项列表（二级按钮网格）
  function renderSubList(catId) {
    const c = CATS.find((x) => x.id === catId);
    if (!c) return;
    catSlot.innerHTML = `
      <div data-l1-active="${c.id}">
        <h2 class="font-serif text-3xl font-semibold tracking-tight mb-6 text-white">${esc(titleOf(c))}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          ${c.subcategories.map((s) => `
            <button type="button" data-l2="${s.id}"
              class="l2-btn text-left px-4 py-3 rounded-2xl border border-white/15 hover:border-white/30 bg-white/6 backdrop-blur-[30px] md:backdrop-blur-[40px] backdrop-saturate-[180%] transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] flex items-center justify-between gap-2 focus:outline-none focus:shadow-[0_0_0_3px_rgba(228,184,99,0.18)]">
              <span class="font-mono text-xs font-medium text-white/80">
                <span class="text-white/40 mr-1.5">${esc(s.id)}</span>
                <span class="l2-title text-sm text-white/80">${esc(subTitleOf(s))}</span>
              </span>
              <span class="l2-arrow text-white/40 text-xs" aria-hidden="true">→</span>
            </button>`).join('')}
        </div>
      </div>`;
    bindL2();
  }

  // 渲染指定小项的条目列表（三级）
  function renderSubPanel(catId, subId) {
    const c = CATS.find((x) => x.id === catId);
    const s = c?.subcategories.find((x) => x.id === subId);
    if (!c || !s) return;
    catSlot.innerHTML = `
      <div data-l2-panel="${s.id}">
        <div class="flex items-center justify-between mb-5">
          <h3 class="font-mono text-sm text-white/60 uppercase tracking-widest">${esc(s.id)} · ${esc(subTitleOf(s))}</h3>
          <button type="button" data-l2-close="${s.id}"
            class="l2-close font-mono text-xs text-white/40 hover:text-white/80 transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] focus:outline-none focus:shadow-[0_0_0_3px_rgba(228,184,99,0.18)] rounded-2xl">
            收起 ↑
          </button>
        </div>
        <ul class="space-y-4">
          ${s.items.map((item) => renderItem(item, s.id)).join('')}
        </ul>
      </div>`;
    bindL2();
  }

  // NavItem 条目 HTML（与 NavItem.astro 同构；SSR 用 Astro 预渲染，运行时用此兜底）
  function renderItem(item, subId) {
    const langTag = document.documentElement.lang?.startsWith('zh') ? 'zh' : 'en';
    const vpnLabel = langTag === 'en' ? '🔓 VPN required' : '🔓 需科学上网';
    const noteText = langTag === 'en' ? (item.note_en || item.note) : item.note;
    const addedDate = item.added ? new Date(item.added + 'T00:00:00') : null;
    const isNew = addedDate ? (Date.now() - addedDate.getTime()) / 86400000 < 14 : false;
    const issueUrl =
      'https://github.com/RedSamerai/personal-site/issues/new?title=' +
      encodeURIComponent(`[失效] ${subId} ${item.name}`) +
      '&body=' + encodeURIComponent('链接已失效');
    return `
      <li class="glass-card group/item flex items-start gap-3 p-5 md:p-6">
        <div class="flex-1 min-w-0 relative z-10">
          <div class="flex items-center gap-2 flex-wrap">
            <a href="${esc(item.url)}" target="_blank" rel="noopener noreferrer"
              class="font-medium text-white hover:text-[#F3DCA8] transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] break-all focus:outline-none focus:shadow-[0_0_0_3px_rgba(228,184,99,0.18)] rounded-2xl">${esc(item.name)}</a>
            ${item.stars ? `<span class="text-xs font-mono text-[#E4B863]">⭐ ${esc(item.stars)}</span>` : ''}
            ${item.vpn ? `<span class="text-xs font-mono text-white/60 bg-white/8 border border-white/15 rounded-2xl px-2 py-0.5">${vpnLabel}</span>` : ''}
            ${isNew ? `<span class="relative flex w-2 h-2" title="新增加入（14天内）">
              <span class="absolute inline-flex w-full h-full rounded-full bg-[#E4B863] opacity-60"></span>
              <span class="relative inline-flex w-2 h-2 rounded-full bg-[#E4B863]"></span>
            </span>` : ''}
          </div>
          ${noteText ? `<p class="mt-1.5 text-sm text-white/60 leading-relaxed max-w-[65ch]">${esc(noteText)}</p>` : ''}
        </div>
        <a href="${esc(issueUrl)}" target="_blank" rel="noopener noreferrer"
          aria-label="${langTag === 'en' ? 'Report broken' : '失效反馈'}" title="${langTag === 'en' ? 'Report broken' : '失效反馈'}"
          class="relative z-10 shrink-0 text-white/40 hover:text-[#E4B863] transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] text-sm opacity-0 group-hover/item:opacity-100 focus:opacity-100 focus:outline-none focus:shadow-[0_0_0_3px_rgba(228,184,99,0.18)] rounded-2xl">⚠</a>
      </li>`;
  }

  function markL1(id) {
    l1Btns.forEach((b) => {
      const on = b.dataset.l1 === id;
      b.classList.toggle('l1-active', on);
      b.setAttribute('aria-expanded', String(on));
      const arrow = b.querySelector('.l1-arrow');
      if (arrow) {
        arrow.textContent = on ? '↓' : '→';
        arrow.classList.toggle('text-accent', on);
      }
    });
  }

  function scrollToTop() {
    if (isMobile()) content.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function bindL2() {
    catSlot.querySelectorAll('.l2-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = openCat;
        const sub = btn.dataset.l2;
        if (openSub === sub) {
          // 点已展开的小项 → 收起回小项列表
          openSub = null;
          renderSubList(cat);
        } else {
          openSub = sub;
          renderSubPanel(cat, sub);
        }
        // 高亮当前小项
        catSlot.querySelectorAll('.l2-btn').forEach((b) => {
          const on = b.dataset.l2 === sub;
          b.classList.toggle('l2-active', on);
          const a = b.querySelector('.l2-arrow');
          if (a) { a.textContent = on ? '↓' : '→'; a.classList.toggle('text-accent', on); }
        });
        scrollToTop();
      });
    });
    const close = catSlot.querySelector('.l2-close');
    if (close) {
      close.addEventListener('click', () => {
        openSub = null;
        renderSubList(openCat);
        catSlot.querySelectorAll('.l2-btn').forEach((b) => {
          b.classList.remove('l2-active');
          const a = b.querySelector('.l2-arrow');
          if (a) { a.textContent = '→'; a.classList.remove('text-accent'); }
        });
      });
    }
  }

  // 一级按钮：点分类 → 显示其小项列表；点已展开的 → 回默认
  l1Btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.l1;
      if (openCat === id) {
        openCat = null; openSub = null;
        catSlot.classList.add('hidden');
        catSlot.innerHTML = '';
        profilePanel.classList.remove('hidden');
        markL1(null);
      } else {
        openCat = id; openSub = null;
        profilePanel.classList.add('hidden');
        catSlot.classList.remove('hidden');
        renderSubList(id);
        markL1(id);
      }
      scrollToTop();
    });
  });
</script>

<style>
  /* 一级选中：香槟金描边 + 玻璃底提亮 + 左移指示 */
  .l1-btn.l1-active {
    border-color: rgba(228, 184, 99, 0.4);
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateX(4px);
  }
  .l2-btn.l2-active {
    border-color: rgba(228, 184, 99, 0.4);
    background-color: rgba(255, 255, 255, 0.1);
  }
  .l1-arrow, .l2-arrow { transition: transform 0.2s ease, color 0.5s cubic-bezier(0.16,1,0.3,1); }
</style>
