---
const { lang = 'zh' } = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from './NavBar.astro';

const footer = {
  zh: '© 2026 RedSamerai · Built with Astro & Tailwind',
  en: '© 2026 RedSamerai · Built with Astro & Tailwind',
};
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
---

<BaseLayout htmlLang={htmlLang}>
  <NavBar lang={lang} />
  <main class="flex-1 pt-16">
    <slot />
  </main>
  <footer class="border-t border-fg/7 py-8 mt-24">
    <div class="max-w-5xl mx-auto px-6 flex items-center justify-between">
      <p class="text-xs text-fg-subtle font-mono">{footer[lang]}</p>
      <a href="https://github.com/RedSamerai" target="_blank" rel="noopener noreferrer"
         class="text-xs text-fg-subtle font-mono hover:text-accent transition-colors">
        GitHub ↗
      </a>
    </div>
  </footer>
</BaseLayout>
