---
const { lang = 'zh' } = Astro.props;
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from './NavBar.astro';
import profile from '../data/profile.json';

const footer = {
  zh: '© 2026 RedSamerai · Built with Astro & Tailwind',
  en: '© 2026 RedSamerai · Built with Astro & Tailwind',
};
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';

// 页脚简介：中文页用中文 tagline，英文页用英文 tagline（profile.json 无 en 字段则回退）
const tagline = lang === 'en' ? 'Curated resources I actually use — quant, AI, screenwriting.' : profile.tagline;
---

<BaseLayout htmlLang={htmlLang}>
  <NavBar lang={lang} />
  <main class="flex-1 pt-16">
    <slot />
  </main>
  <footer class="border-t border-white/10 bg-white/12 backdrop-blur-[60px] backdrop-saturate-[180%] py-10 mt-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <span class="font-serif text-xl font-semibold text-white">RedSamerai</span>
          <p class="mt-2 text-xs text-white/60 max-w-xs">{tagline}</p>
        </div>
        <div>
          <h4 class="text-xs font-mono text-white/40 uppercase tracking-widest mb-3">{lang === 'en' ? 'Nav' : '导航'}</h4>
          <ul class="space-y-1.5 text-sm">
            <li><a href={lang === 'en' ? '/en/' : '/'} class="text-white/80 hover:text-white transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">首页 / Home</a></li>
            <li><a href={lang === 'en' ? '/en/about' : '/about'} class="text-white/80 hover:text-white transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">关于 / About</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-xs font-mono text-white/40 uppercase tracking-widest mb-3">{lang === 'en' ? 'Social' : '社交'}</h4>
          <ul class="space-y-1.5 text-sm">
            <li>
              <a
                href="https://github.com/RedSamerai"
                target="_blank"
                rel="noopener noreferrer"
                class="text-white/80 hover:text-[#F3DCA8] transition-colors duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
              >
                GitHub ↗
              </a>
            </li>
          </ul>
        </div>
      </div>
      <p class="mt-8 pt-6 border-t border-white/10 text-xs text-white/40 font-mono">{footer[lang]}</p>
    </div>
  </footer>
</BaseLayout>
