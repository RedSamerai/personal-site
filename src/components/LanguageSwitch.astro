---
// 语言切换按钮，放在导航栏
// 当前语言由父组件通过 lang 属性传入（'zh' | 'en'）
const { lang = 'zh' } = Astro.props;
// 切换后跳转到对应语言的同一页面（统一以 / 开头的绝对路径）
const currentPath = Astro.url.pathname;
let switchPath: string;
if (lang === 'zh') {
  // /about -> /en/about ; / -> /en/
  switchPath = '/en' + currentPath;
} else {
  // /en/about -> /about ; /en/ -> /
  switchPath = currentPath.replace(/^\/en(?=\/|$)/, '');
}
const switchLabel = lang === 'zh' ? 'EN' : '中文';
---

<a
  href={switchPath}
  class="text-sm font-mono text-muted hover:text-accent transition-colors border border-muted/30 rounded px-2 py-0.5"
  aria-label="Switch language"
>
  {switchLabel}
</a>
