---
// 基础布局：head/字体/背景光斑 + body 骨架
// props:
//   htmlLang: 'zh-CN' | 'en'（<html lang>）
//   title: 页面标题（<title>）
//   description: 本地化 meta description
//   pagePath: ''=首页、'about'=关于页（不带 /en/ 前缀）
//   isEn: 是否英文页（决定 canonical 指向 + og:locale）
const { htmlLang = 'zh-CN', title = 'RedSamerai', description = '', pagePath = '', isEn = false } = Astro.props;
import '../styles/global.css';

// canonical / hreflang / og 的绝对 URL
const site = Astro.site ?? new URL('https://c63ec20e.personal-site-ea5.pages.dev');
const zhUrl = new URL(pagePath ? `/${pagePath}` : '/', site).href;
const enUrl = new URL(pagePath ? `/en/${pagePath}` : '/en/', site).href;
const canonical = isEn ? enUrl : zhUrl;

// JSON-LD：站点 + 人物
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'RedSamerai', url: site.href },
    { '@type': 'Person', name: 'RedSamerai', url: zhUrl },
  ],
});
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" href="https://astro.build" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- canonical + hreflang（中英双页互链 + x-default 指向 en） -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <!-- Open Graph / Twitter 分享卡（og-cover.png 就位后再补 og:image / twitter:image） -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RedSamerai" />
    <meta property="og:locale" content={isEn ? 'en_US' : 'zh_CN'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- 站点级 JSON-LD -->
    <script type="application/ld+json" set:html={jsonLd} />
    <script>
      (function() {
        try {
          const saved = localStorage.getItem('theme');
          // 默认深色（Nocturne 夜景），不跟随系统
          const theme = saved || 'dark';
          const root = document.documentElement;
          root.setAttribute('data-theme', theme);
          // 原生控件（滚动条/表单）跟随主题
          root.style.colorScheme = theme;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-bg text-fg">
    <!-- 背景光斑层（fixed，在玻璃面板之下，玻璃才有东西可模糊） -->
    <div aria-hidden="true" class="nocturne-wells fixed inset-0 -z-10 pointer-events-none overflow-hidden">
      <div class="absolute -top-32 -right-20 w-[560px] h-[560px] rounded-full"
           style="background: radial-gradient(circle, rgba(124,156,196,0.28) 0%, transparent 65%)"></div>
      <div class="absolute -bottom-36 -left-24 w-[520px] h-[520px] rounded-full"
           style="background: radial-gradient(circle, rgba(51,81,122,0.35) 0%, transparent 65%)"></div>
      <div class="absolute top-[35%] left-[45%] w-[480px] h-[480px] rounded-full"
           style="background: radial-gradient(circle, rgba(228,184,99,0.10) 0%, transparent 60%)"></div>
    </div>

    <slot />

    <script>
      (function() {
        try {
          // 渐进增强：仅当 JS 可用 + 未请求减动效时，才启用 fade-in 动画
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduce) {
            document.documentElement.classList.add('js-ready');
            const io = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('visible');
                  io.unobserve(entry.target);
                }
              });
            }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
            document.querySelectorAll('.fade-in').forEach(el => io.observe(el));
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
