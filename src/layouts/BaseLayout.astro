---
// 基础布局：负责 <head>（字体/SEO）与 <body> 骨架
// htmlLang: 由 Layout 传入，'zh-CN' | 'en'
const { htmlLang = 'zh-CN' } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="RedSamerai 的个人主页" />
    <meta name="generator" href="https://astro.build" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans+SC:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
